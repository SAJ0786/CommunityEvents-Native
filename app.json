{
  "expo": {
    "name": "Community Connect Australia",
    "slug": "community-events-australia-native",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-store-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-community-connect.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8faf9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "info.siza.communityevents",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon-store-1024.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Community Connect Australia to use your camera when you choose to live stream an event.",
        "NSMicrophoneUsageDescription": "Allow Community Connect Australia to use your microphone when you choose to live stream an event."
      }
    },
    "android": {
      "package": "info.siza.communityevents.app",
      "versionCode": 36,
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "firebaseProjectId": "community-event-8b639",
      "androidCertificateSha1": "5E8F16062EA3CD2C4A0D547876BAA6F38CABF625",
      "testBuild": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "dynamic"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Community Connect Australia to add community events to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Community Connect Australia to show nearby events and community businesses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Community Connect Australia to select event posters and business images from your photos.",
          "microphonePermission": "Allow Community Connect Australia to use your microphone when you choose to live stream an event."
        }
      ]
    ]
  }
}
