rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function isAnonymous() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isRegistered(){ return signedIn() && !isAnonymous(); }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role()        { return userDoc().data.role; }
    function isAdmin()     { return isRegistered() && (role() == 'admin' || role() == 'superAdmin'); }
    function isSuperAdmin(){ return isRegistered() && role() == 'superAdmin'; }
    function defaultCity()  { return 'sydney'; }
    function adminCity() {
      return userDoc().data.adminCity != null
        ? userDoc().data.adminCity
        : (userDoc().data.defaultCity != null ? userDoc().data.defaultCity : defaultCity());
    }
    function eventCity(data) {
      return data.metroArea != null ? data.metroArea : defaultCity();
    }
    function isCityAdminForEvent(data) {
      return isRegistered() && role() == 'admin' && eventCity(data) == adminCity();
    }
    function canUpdateOwnProfile(userId) {
      return request.auth.uid == userId
        && (
          role() != 'admin'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['defaultCity'])
          || request.resource.data.role == 'user'
        );
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isRegistered() && (request.auth.uid == userId || isAdmin());
      allow create: if isRegistered() && request.auth.uid == userId;
      allow update: if isRegistered() && (canUpdateOwnProfile(userId) || isSuperAdmin());
      allow delete: if isRegistered() && (request.auth.uid == userId || isSuperAdmin());
    }

    // ── Events ─────────────────────────────────────────────────────────────────
    // Registered users can read full event documents. Guests use the
    // getPublicEvents Cloud Function, which returns a sanitized field set.
    match /events/{eventId} {
      allow read:           if isRegistered();
      allow create:         if isRegistered()
                               && request.resource.data.createdByUserId == request.auth.uid;
      allow update:         if isRegistered()
                               && (resource.data.createdByUserId == request.auth.uid
                                   || isSuperAdmin()
                                   || (isCityAdminForEvent(resource.data)
                                       && eventCity(request.resource.data) == adminCity()));
      allow delete:         if isRegistered()
                               && (resource.data.createdByUserId == request.auth.uid
                                   || isSuperAdmin()
                                   || isCityAdminForEvent(resource.data));
    }

    match /eventAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.action == 'event.ownership_transferred';
      allow update, delete: if false;
    }

    // Private Business Directory submissions. These documents contain owner,
    // declaration, exact-address and moderation data and are never public.
    function isBusinessOwner(data) {
      return isRegistered() && data.ownerId == request.auth.uid;
    }

    function validBusinessCreate(data) {
      return data.name is string
        && data.name.size() >= 2
        && data.abn is string
        && data.abnStatus is string
        && (data.abnStatus == 'has'
          ? data.abn.size() == 11
          : data.abn.size() == 0)
        && data.categoryId is string
        && data.subcategoryIds is list
        && data.subcategoryIds.size() > 0
        && data.contact is map
        && data.location is map
        && data.referrer is map
        && data.referrer.name is string
        && data.referrer.name.size() >= 2
        && data.referrer.phone is string
        && data.referrer.location is string
        && data.referrer.location.size() >= 2
        && data.referrer.consentConfirmed == true
        && data.listingDeclarationAccepted == true
        && data.listingTermsVersion is string
        && data.listingTermsVersion.size() > 0;
    }

    function ownerBusinessFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'nameLower', 'description', 'categoryId', 'categoryIds', 'category', 'categories',
        'subcategoryIds', 'subcategories', 'abnStatus', 'abn', 'logoUrl', 'logoPath',
        'coverUrl', 'coverPath', 'contact', 'social', 'location',
        'hours', 'hoursSummary', 'referrer', 'referrerReview', 'previousStatus', 'status',
        'abnVerified', 'identityVerified', 'verificationBadge',
        'abrVerification', 'abnCheckedAt',
        'rejectionReason', 'publishedSnapshot', 'hasPublishedVersion', 'reviewType',
        'listingDeclarationAccepted', 'listingTermsVersion',
        'listingConsentAtClient', 'listingConsentAt', 'lastSubmittedBy', 'updatedAt', 'submittedAt'
      ]);
    }

    match /businesses/{businessId} {
      allow read: if isBusinessOwner(resource.data)
                    || isAdmin();

      allow create: if isRegistered()
                      && request.resource.data.ownerId == request.auth.uid
                      && validBusinessCreate(request.resource.data)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.tier == 'free'
                      && request.resource.data.abnVerified == false
                      && request.resource.data.foundingMember == false;

      allow update: if isAdmin()
                      || (isBusinessOwner(resource.data)
                          && request.resource.data.ownerId == request.auth.uid
                          && ownerBusinessFieldsOnly()
                          && request.resource.data.status == 'pending'
                          && request.resource.data.tier == resource.data.tier
                          && request.resource.data.foundingMember == resource.data.foundingMember
                          && request.resource.data.referrerReview.status == 'pending'
                          && request.resource.data.referrerReview.checkedBy == ''
                          && request.resource.data.abnVerified == false);

      allow delete: if isAdmin();
    }

    // Sanitised projection used by the public directory. It deliberately omits
    // owner identity, private contact routing, exact home addresses, ABN number,
    // declarations and moderation fields.
    match /publicBusinesses/{businessId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
                          == request.auth.uid);
    }

    // Aggregate interaction counters are written only by the trusted callable
    // function. They contain no message text or customer identity.
    match /businessStatistics/{businessId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /enquiries/{threadId} {
        allow read, write: if false;
      }
    }

    // Authenticated contact routing is separate from the public listing. The
    // client receives only the owner UID needed to create an in-app thread.
    match /businessContactRoutes/{businessId} {
      allow read: if isRegistered() && resource.data.active == true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
                          == request.auth.uid);
    }

    function isPromotionOwner(data) {
      return isRegistered() && data.ownerId == request.auth.uid;
    }

    function promotionBusiness(data) {
      return get(/databases/$(database)/documents/businesses/$(data.businessId));
    }

    function ownsApprovedPromotionBusiness(data) {
      return data.businessId is string
        && promotionBusiness(data).data.ownerId == request.auth.uid
        && (promotionBusiness(data).data.status == 'approved'
          || promotionBusiness(data).data.hasPublishedVersion == true)
        && promotionBusiness(data).data.hidden != true;
    }

    function validPromotion(data) {
      return data.title is string
        && data.title.size() >= 3
        && data.briefText is string
        && data.briefText.size() >= 10
        && data.fullDetails is string
        && data.fullDetails.size() >= 20
        && data.startDate is string
        && data.endDate is string
        && data.endDate >= data.startDate;
    }

    function ownerPromotionFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'briefText', 'discountText', 'fullDetails',
        'startDate', 'endDate', 'imageUrl', 'imagePath', 'status',
        'hidden', 'rejectionReason', 'lastSubmittedBy', 'updatedAt', 'submittedAt'
      ]);
    }

    match /businessPromotions/{promotionId} {
      allow read: if isPromotionOwner(resource.data)
                    || isAdmin();

      allow create: if isRegistered()
                      && request.resource.data.ownerId == request.auth.uid
                      && ownsApprovedPromotionBusiness(request.resource.data)
                      && validPromotion(request.resource.data)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.boosted == false
                      && request.resource.data.hidden == false;

      allow update: if isAdmin()
                      || (isPromotionOwner(resource.data)
                          && request.resource.data.ownerId == request.auth.uid
                          && request.resource.data.businessId == resource.data.businessId
                          && ownsApprovedPromotionBusiness(request.resource.data)
                          && ownerPromotionFieldsOnly()
                          && validPromotion(request.resource.data)
                          && request.resource.data.status == 'pending'
                          && request.resource.data.boosted == resource.data.boosted
                          && request.resource.data.hidden == false);

      allow delete: if isAdmin() || isPromotionOwner(resource.data);
    }

    // Public promotions are sanitised projections and never include owner or
    // moderation fields from the private submission.
    match /publicBusinessPromotions/{promotionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businessPromotions/$(promotionId)).data.ownerId
                          == request.auth.uid);
    }

    match /businessAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.businessId is string
                      && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // Historical events are moved here by the scheduled Admin SDK function.
    // They are excluded from the live app and available only to administrators.
    match /archivedEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Settings ───────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isSuperAdmin()
                     || (isAdmin()
                         && !(docId in ['hijriCalendar', 'hijriObservances']));
    }

    // ── Calendar subscriptions ─────────────────────────────────────────────────
    match /calendarSubscriptions/{uid} {
      allow read:  if isRegistered() && isAdmin();
      allow write: if false;
    }

    // ── Mail ───────────────────────────────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Recipient-specific workflow notifications are created only by trusted
    // Cloud Functions. Users may read their own records and mark them read.
    match /userNotifications/{notificationId} {
      allow read: if isRegistered() && resource.data.recipientUid == request.auth.uid;
      allow create, delete: if false;
      allow update: if isRegistered()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // ── Banned users — readable by anyone logging in (for ban check) ──────────
    match /bannedUsers/{docId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── Organisations — public read, admin write ────────────────────────────
    match /organisations/{orgId} {
      allow read:  if true;           // anyone can read (needed for event card logos)
      allow write: if isAdmin();      // only admins can add/edit/delete
    }

    // ── Native Stream Sessions ──────────────────────────────────────────────
    match /nativeStreamSessions/{sessionId} {
      allow read, write: if false;
    }

    // Stream catalogue is exposed only through listStreamVideos, which omits
    // YouTube IDs and URLs for guests.
    match /streamVideos/{videoId} {
      allow read, write: if false;
    }

    function isHostThreadParticipant(data) {
      return isRegistered()
        && data.participantUids is list
        && data.participantUids.hasAny([request.auth.uid]);
    }

    match /hostMessageThreads/{threadId} {
      allow read: if isHostThreadParticipant(resource.data);
      allow create: if isRegistered()
        && request.resource.data.type == 'host'
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if isHostThreadParticipant(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isHostThreadParticipant(
          get(/databases/$(database)/documents/hostMessageThreads/$(threadId)).data
        );
        allow create: if isHostThreadParticipant(
          get(/databases/$(database)/documents/hostMessageThreads/$(threadId)).data
        ) && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    function isBusinessThreadParticipant(data) {
      return isRegistered()
        && data.participantUids is list
        && data.participantUids.hasAny([request.auth.uid]);
    }

    match /businessMessageThreads/{threadId} {
      allow read: if isBusinessThreadParticipant(resource.data);
      allow create: if isRegistered()
        && request.resource.data.type == 'business'
        && request.resource.data.businessId is string
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids.hasAny([request.resource.data.ownerUid])
        && request.resource.data.senderUid == request.auth.uid
        && get(/databases/$(database)/documents/businessContactRoutes/$(request.resource.data.businessId)).data.active == true
        && get(/databases/$(database)/documents/businessContactRoutes/$(request.resource.data.businessId)).data.ownerUid
          == request.resource.data.ownerUid;
      allow update: if isBusinessThreadParticipant(resource.data)
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isBusinessThreadParticipant(
          get(/databases/$(database)/documents/businessMessageThreads/$(threadId)).data
        );
        allow create: if isBusinessThreadParticipant(
          get(/databases/$(database)/documents/businessMessageThreads/$(threadId)).data
        )
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    function canReadFeedbackThread(data) {
      return isSuperAdmin()
        || (isRegistered()
          && role() == 'admin'
          && data.target == 'cityAdmins'
          && data.city == adminCity())
        || (isRegistered()
          && data.senderUid == request.auth.uid);
    }

    function guestFeedbackCreate(data) {
      return (!signedIn() || isAnonymous())
        && data.type == 'feedback'
        && data.senderUid == null
        && data.senderGuestId is string
        && data.target in ['cityAdmins', 'superAdmins']
        && data.city is string;
    }

    match /adminFeedbackThreads/{threadId} {
      allow read: if canReadFeedbackThread(resource.data);
      allow create: if guestFeedbackCreate(request.resource.data)
        || (isRegistered()
          && request.resource.data.type == 'feedback'
          && request.resource.data.senderUid == request.auth.uid);
      allow update: if canReadFeedbackThread(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadFeedbackThread(
          get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data
        );
        allow create: if (
          canReadFeedbackThread(get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data)
          && request.resource.data.senderUid == request.auth.uid
        ) || (
          (!signedIn() || isAnonymous())
          && request.resource.data.senderUid == null
          && get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data.senderGuestId == request.resource.data.senderGuestId
        );
        allow update, delete: if false;
      }
    }

    match /ai_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Edit OTPs — Cloud Function only ──────────────────────────────────────
    match /editOtps/{docId} {
      allow read, write: if false;
    }

    // ── Edit Sessions — Cloud Function only ──────────────────────────────────
    match /editSessions/{docId} {
      allow read, write: if false;
    }
  }
}
