rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function isAnonymous() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isRegistered(){ return signedIn() && !isAnonymous(); }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role()        { return userDoc().data.role; }
    function isAdmin()     { return isRegistered() && (role() == 'admin' || role() == 'superAdmin'); }
    function isSuperAdmin(){ return isRegistered() && role() == 'superAdmin'; }
    function defaultCity()  { return 'sydney'; }
    function adminCity() {
      return userDoc().data.adminCity != null
        ? userDoc().data.adminCity
        : (userDoc().data.defaultCity != null ? userDoc().data.defaultCity : defaultCity());
    }
    function eventCity(data) {
      return data.metroArea != null ? data.metroArea : defaultCity();
    }
    function isCityAdminForEvent(data) {
      return isRegistered() && role() == 'admin' && eventCity(data) == adminCity();
    }
    function businessCity(data) {
      return data.location != null && data.location.city != null
        ? data.location.city
        : (data.metroArea != null ? data.metroArea : defaultCity());
    }
    function isCityAdminForBusiness(currentData, requestedData) {
      return isRegistered()
        && role() == 'admin'
        && businessCity(currentData) == adminCity()
        && businessCity(requestedData) == adminCity();
    }
    function canUpdateOwnProfile(userId) {
      return request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isActive', 'accountStatus', 'archivedAt', 'archivedBy',
          'accountDeletedAt', 'bannedAt', 'bannedBy',
          'adminCity', 'permissions', 'security'
        ])
        && (
          role() != 'admin'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['defaultCity'])
          || request.resource.data.role == 'user'
        );
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isRegistered() && (request.auth.uid == userId || isAdmin());
      allow create: if isRegistered()
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly([
                     'role', 'savedEvents', 'savedBusinesses', 'isActive',
                     'accountStatus', 'fullName', 'email',
                     'emailLower', 'phone', 'phoneVerified', 'defaultCity',
                     'defaultModule', 'pushNotificationsEnabled',
                     'smsNotificationsEnabled', 'emailNotificationsEnabled',
                     'eventNotificationsEnabled', 'businessNotificationsEnabled',
                     'prayerRemindersEnabled', 'reminderEmailEnabled',
                     'adminAlertEmailEnabled', 'privacyAccepted',
                     'privacyPolicyVersion', 'termsAccepted', 'termsVersion',
                     'legalAcceptedAtClient'
                   ])
                   && request.resource.data.role == 'user'
                   && request.resource.data.isActive == true
                   && request.resource.data.accountStatus == 'active'
                   && request.resource.data.savedEvents is list
                   && (!request.resource.data.keys().hasAny(['savedBusinesses'])
                       || request.resource.data.savedBusinesses is list);
      allow update: if isRegistered() && (canUpdateOwnProfile(userId) || isSuperAdmin());
      allow delete: if false;
    }

    // ── Events ─────────────────────────────────────────────────────────────────
    // Registered users can read full event documents. Guests use the
    // getPublicEvents Cloud Function, which returns a sanitized field set.
    match /events/{eventId} {
      allow read:           if isRegistered();
      allow create:         if isRegistered()
                               && request.resource.data.createdByUserId == request.auth.uid;
      allow update:         if isRegistered()
                               && (resource.data.createdByUserId == request.auth.uid
                                   || isSuperAdmin()
                                   || (isCityAdminForEvent(resource.data)
                                       && eventCity(request.resource.data) == adminCity()));
      // Event removal is performed only by the trusted archive callable, which
      // copies the complete record to archivedEvents before removing it here.
      allow delete:         if false;
    }

    match /eventAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.action == 'event.ownership_transferred';
      allow update, delete: if false;
    }

    // Private Business Directory submissions. These documents contain owner,
    // declaration, exact-address and moderation data and are never public.
    function isBusinessOwner(data) {
      return isRegistered() && data.ownerId == request.auth.uid;
    }

    function validBusinessCreate(data) {
      return data.name is string
        && data.name.size() >= 2
        && data.abn is string
        && data.abnStatus is string
        && (data.abnStatus == 'has'
          ? data.abn.size() == 11
          : data.abn.size() == 0)
        && data.categoryId is string
        && data.subcategoryIds is list
        && data.subcategoryIds.size() > 0
        && data.contact is map
        && data.location is map
        && data.referrer is map
        && data.referrer.name is string
        && data.referrer.name.size() >= 2
        && data.referrer.phone is string
        && data.referrer.location is string
        && data.referrer.location.size() >= 2
        && data.referrer.consentConfirmed == true
        && data.listingDeclarationAccepted == true
        && data.listingTermsVersion is string
        && data.listingTermsVersion.size() > 0;
    }

    function ownerBusinessFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'nameLower', 'description', 'categoryId', 'categoryIds', 'category', 'categories',
        'subcategoryIds', 'subcategories', 'abnStatus', 'abn', 'logoUrl', 'logoPath',
        'coverUrl', 'coverPath', 'contact', 'social', 'location',
        'hours', 'hoursSummary', 'referrer', 'referrerReview', 'previousStatus', 'status',
        'abnVerified', 'identityVerified', 'verificationBadge',
        'abrVerification', 'abnCheckedAt',
        'rejectionReason', 'publishedSnapshot', 'hasPublishedVersion', 'reviewType',
        'listingDeclarationAccepted', 'listingTermsVersion',
        'listingConsentAtClient', 'listingConsentAt', 'lastSubmittedBy', 'updatedAt', 'submittedAt'
      ]);
    }

    function cityAdminBusinessFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'hidden', 'tier', 'abnVerified', 'identityVerified',
        'verificationBadge', 'referrerReview', 'foundingMember',
        'priorHistoryReview', 'rejectionReason', 'hasPublishedVersion',
        'publishedSnapshot', 'reviewType', 'approvedBy', 'approvedAt',
        'rejectedBy', 'rejectedAt', 'reviewedAt', 'updatedAt',
        'previousStatus', 'lifecycleState', 'archiveReason', 'archivedAt',
        'archivedBy', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy',
        'restorationReason', 'abnCheckedAt', 'abrVerification'
      ]);
    }

    match /businesses/{businessId} {
      allow read: if isBusinessOwner(resource.data)
                    || isAdmin();

      allow create: if isRegistered()
                      && request.resource.data.ownerId == request.auth.uid
                      && validBusinessCreate(request.resource.data)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.tier == 'free'
                      && request.resource.data.abnVerified == false
                      && request.resource.data.foundingMember == false;

      // City admins may archive an active record, but only Super Admins may
      // mark a record deleted or restore any historical record.
      allow update: if isSuperAdmin()
                      || (isCityAdminForBusiness(resource.data, request.resource.data)
                          && !(resource.data.status in ['archived', 'deleted'])
                          && request.resource.data.status != 'deleted'
                          && cityAdminBusinessFieldsOnly())
                      || (isBusinessOwner(resource.data)
                          && !(resource.data.status in ['archived', 'deleted'])
                          && request.resource.data.ownerId == request.auth.uid
                          && ownerBusinessFieldsOnly()
                          && request.resource.data.status == 'pending'
                          && request.resource.data.tier == resource.data.tier
                          && request.resource.data.foundingMember == resource.data.foundingMember
                          && request.resource.data.referrerReview.status == 'pending'
                          && request.resource.data.referrerReview.checkedBy == ''
                          && request.resource.data.abnVerified == false);

      // Private business records are permanent. "Delete" is a lifecycle state
      // and public projections are removed instead of erasing the source record.
      allow delete: if false;
    }

    // Sanitised projection used by the public directory. It deliberately omits
    // owner identity, private contact routing, exact home addresses, ABN number,
    // declarations and moderation fields.
    match /publicBusinesses/{businessId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
                          == request.auth.uid);
    }

    // Aggregate interaction counters are written only by the trusted callable
    // function. They contain no message text or customer identity.
    match /businessStatistics/{businessId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /enquiries/{threadId} {
        allow read, write: if false;
      }
    }

    // Authenticated contact routing is separate from the public listing. The
    // client receives only the owner UID needed to create an in-app thread.
    match /businessContactRoutes/{businessId} {
      allow read: if isRegistered() && resource.data.active == true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
                          == request.auth.uid);
    }

    function isPromotionOwner(data) {
      return isRegistered() && data.ownerId == request.auth.uid;
    }

    function promotionBusiness(data) {
      return get(/databases/$(database)/documents/businesses/$(data.businessId));
    }

    function ownsApprovedPromotionBusiness(data) {
      return data.businessId is string
        && promotionBusiness(data).data.ownerId == request.auth.uid
        && (promotionBusiness(data).data.status == 'approved'
          || promotionBusiness(data).data.hasPublishedVersion == true)
        && promotionBusiness(data).data.hidden != true;
    }

    function validPromotion(data) {
      return data.title is string
        && data.title.size() >= 3
        && data.briefText is string
        && data.briefText.size() >= 10
        && data.fullDetails is string
        && data.fullDetails.size() >= 20
        && data.startDate is string
        && data.endDate is string
        && data.endDate >= data.startDate;
    }

    function ownerPromotionFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'briefText', 'discountText', 'fullDetails',
        'startDate', 'endDate', 'imageUrl', 'imagePath', 'status',
        'hidden', 'rejectionReason', 'lastSubmittedBy', 'updatedAt', 'submittedAt'
      ]);
    }

    function ownerPromotionArchiveOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'previousStatus', 'status', 'hidden', 'archivedAt', 'archivedBy',
        'archiveReason', 'updatedAt'
      ])
        && request.resource.data.status == 'archived'
        && request.resource.data.hidden == true
        && request.resource.data.archivedBy == request.auth.uid;
    }

    match /businessPromotions/{promotionId} {
      allow read: if isPromotionOwner(resource.data)
                    || isAdmin();

      allow create: if isRegistered()
                      && request.resource.data.ownerId == request.auth.uid
                      && ownsApprovedPromotionBusiness(request.resource.data)
                      && validPromotion(request.resource.data)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.boosted == false
                      && request.resource.data.hidden == false;

      allow update: if isSuperAdmin()
                      || (isAdmin()
                          && !(resource.data.status in ['archived', 'deleted'])
                          && request.resource.data.status != 'deleted')
                      || (isPromotionOwner(resource.data)
                          && request.resource.data.ownerId == request.auth.uid
                          && ownerPromotionArchiveOnly())
                      || (isPromotionOwner(resource.data)
                          && request.resource.data.ownerId == request.auth.uid
                          && request.resource.data.businessId == resource.data.businessId
                          && ownsApprovedPromotionBusiness(request.resource.data)
                          && ownerPromotionFieldsOnly()
                          && validPromotion(request.resource.data)
                          && request.resource.data.status == 'pending'
                          && request.resource.data.boosted == resource.data.boosted
                          && request.resource.data.hidden == false);

      allow delete: if false;
    }

    // Public promotions are sanitised projections and never include owner or
    // moderation fields from the private submission.
    match /publicBusinessPromotions/{promotionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
                    || (isRegistered()
                        && get(/databases/$(database)/documents/businessPromotions/$(promotionId)).data.ownerId
                          == request.auth.uid);
    }

    match /businessAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.businessId is string
                      && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // Historical events are moved here by the scheduled Admin SDK function.
    // They are excluded from the live app and available only to administrators.
    match /archivedEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Permanent account snapshots retained for audit and restoration. Only
    // Super Admins can inspect them; trusted Cloud Functions are the only writer.
    match /archivedUsers/{userId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Privacy-safe diagnostic register ───────────────────────────────────────
    // Crash stacks remain in Firebase Crashlytics. These documents provide a
    // searchable installation/session timeline without typed form contents,
    // addresses, phone numbers, email addresses, credentials or stream keys.
    function validDiagnosticCreate(data) {
      return signedIn()
        && data.reporterUid == request.auth.uid
        && data.sessionId is string
        && data.sessionId.size() >= 12
        && data.sessionId.size() <= 40
        && data.installationId is string
        && data.installationId.size() >= 12
        && data.installationId.size() <= 40
        && data.platform in ['android', 'ios', 'web']
        && data.recentEvents is list
        && data.recentEvents.size() <= 40
        && data.adminStatus == 'new'
        && data.archived == false
        && data.keys().hasOnly([
          'sessionId', 'installationId', 'reporterUid', 'userUid', 'isAnonymous',
          'platform', 'osVersion', 'deviceModel', 'appVersion', 'buildNumber',
          'environment', 'startedAt', 'startedAtClient', 'lastSeenAt',
          'lastSeenAtClient', 'previousSessionId', 'previousCrashDetected',
          'crashDetected', 'diagnosticStatus', 'severity', 'errorCount',
          'currentScreen', 'feature', 'authenticationState', 'appState',
          'recentEvents', 'adminStatus', 'adminNote', 'archived'
        ]);
    }

    function diagnosticOwnerUpdateOnly() {
      return signedIn()
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.installationId == resource.data.installationId
        && request.resource.data.recentEvents is list
        && request.resource.data.recentEvents.size() <= 40
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userUid', 'isAnonymous', 'lastSeenAt', 'lastSeenAtClient',
          'diagnosticStatus', 'severity', 'errorCount', 'currentScreen',
          'feature', 'authenticationState', 'appState', 'recentEvents',
          'crashDetected', 'crashDetectedAt', 'crashDetectedAtClient'
        ]);
    }

    function diagnosticAdminReviewOnly() {
      return isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminStatus', 'adminNote', 'archived', 'reviewedBy', 'reviewedAt',
          'archivedBy', 'archivedAt', 'restoredBy', 'restoredAt'
        ]);
    }

    match /diagnosticSessions/{diagnosticId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if validDiagnosticCreate(request.resource.data);
      allow update: if diagnosticOwnerUpdateOnly() || diagnosticAdminReviewOnly();
      allow delete: if false;
    }

    // ── Settings ───────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isSuperAdmin()
                     || (isAdmin()
                         && !(docId in ['hijriCalendar', 'hijriObservances']));
    }

    // ── Calendar subscriptions ─────────────────────────────────────────────────
    match /calendarSubscriptions/{uid} {
      allow read:  if isRegistered() && isAdmin();
      allow write: if false;
    }

    // ── Mail ───────────────────────────────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Recipient-specific workflow notifications are created only by trusted
    // Cloud Functions. Users may read their own records and mark them read.
    match /userNotifications/{notificationId} {
      allow read: if isRegistered() && resource.data.recipientUid == request.auth.uid;
      allow create, delete: if false;
      allow update: if isRegistered()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // Ban history is permanent and restricted to Super Admin review.
    match /bannedUsers/{docId} {
      allow read:  if isSuperAdmin();
      allow write: if false;
    }

    // ── Organisations — public read, admin write ────────────────────────────
    match /organisations/{orgId} {
      allow read:  if true;           // anyone can read (needed for event card logos)
      allow write: if isAdmin();      // only admins can add/edit/delete
    }

    // ── Native Stream Sessions ──────────────────────────────────────────────
    match /nativeStreamSessions/{sessionId} {
      allow read, write: if false;
    }

    // Stream catalogue is exposed only through listStreamVideos, which omits
    // YouTube IDs and URLs for guests.
    match /streamVideos/{videoId} {
      allow read, write: if false;
    }

    function isHostThreadParticipant(data) {
      return isRegistered()
        && data.participantUids is list
        && data.participantUids.hasAny([request.auth.uid]);
    }

    match /hostMessageThreads/{threadId} {
      allow read: if isHostThreadParticipant(resource.data);
      allow create: if isRegistered()
        && request.resource.data.type == 'host'
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids.hasAny([request.resource.data.hostUid])
        && request.resource.data.hostUid != request.auth.uid
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if isHostThreadParticipant(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isHostThreadParticipant(
          get(/databases/$(database)/documents/hostMessageThreads/$(threadId)).data
        );
        allow create: if isHostThreadParticipant(
          get(/databases/$(database)/documents/hostMessageThreads/$(threadId)).data
        ) && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    function isBusinessThreadParticipant(data) {
      return isRegistered()
        && data.participantUids is list
        && data.participantUids.hasAny([request.auth.uid]);
    }

    function businessThreadIsBlocked(data) {
      return data.get('adminBlocked', false) == true
        || data.get('blockedBy', {}).get(data.ownerUid, false) == true
        || data.get('blockedBy', {}).get(data.senderUid, false) == true;
    }

    function businessThreadParticipantUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt', 'lastMessage', 'lastSenderUid', 'unreadBy', 'blockedBy'
      ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['blockedBy'])
          || request.resource.data.get('blockedBy', {}).diff(resource.data.get('blockedBy', {}))
            .affectedKeys().hasOnly([request.auth.uid]));
    }

    function businessThreadAdminModerationOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'adminBlocked', 'adminBlockedReason', 'adminBlockedBy',
        'adminBlockedAt', 'updatedAt'
      ]);
    }

    match /businessMessageThreads/{threadId} {
      allow read: if isBusinessThreadParticipant(resource.data);
      allow create: if isRegistered()
        && request.resource.data.type == 'business'
        && request.resource.data.businessId is string
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids.hasAny([request.resource.data.ownerUid])
        && request.resource.data.senderUid == request.auth.uid
        && get(/databases/$(database)/documents/businessContactRoutes/$(request.resource.data.businessId)).data.active == true
        && get(/databases/$(database)/documents/businessContactRoutes/$(request.resource.data.businessId)).data.ownerUid
          == request.resource.data.ownerUid;
      allow update: if (isBusinessThreadParticipant(resource.data)
          && businessThreadParticipantUpdateOnly())
        || (isAdmin() && businessThreadAdminModerationOnly());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isBusinessThreadParticipant(
          get(/databases/$(database)/documents/businessMessageThreads/$(threadId)).data
        );
        allow create: if isBusinessThreadParticipant(
          get(/databases/$(database)/documents/businessMessageThreads/$(threadId)).data
        )
          && !businessThreadIsBlocked(
            get(/databases/$(database)/documents/businessMessageThreads/$(threadId)).data
          )
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    function canReadFeedbackThread(data) {
      return isSuperAdmin()
        || (isRegistered()
          && role() == 'admin'
          && data.target == 'cityAdmins'
          && data.city == adminCity())
        || (isRegistered()
          && data.senderUid == request.auth.uid);
    }

    function feedbackMessageStateUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt', 'lastMessage', 'lastSenderUid', 'unreadBy',
        'unreadForSuperAdmins', 'unreadForCityAdmins'
      ]);
    }

    function feedbackModerationUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'moderationStatus', 'moderationDecision', 'moderationReason',
        'moderatedBy', 'moderatedAt', 'updatedAt'
      ])
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderationStatus in [
          'under-review', 'dismissed', 'takedown', 'conversation-blocked', 'closed'
        ];
    }

    function guestFeedbackCreate(data) {
      return (!signedIn() || isAnonymous())
        && data.type == 'feedback'
        && data.senderUid == null
        && data.senderGuestId is string
        && data.target in ['cityAdmins', 'superAdmins']
        && data.city is string;
    }

    match /adminFeedbackThreads/{threadId} {
      allow read: if canReadFeedbackThread(resource.data);
      allow create: if guestFeedbackCreate(request.resource.data)
        || (isRegistered()
          && request.resource.data.type == 'feedback'
          && request.resource.data.senderUid == request.auth.uid);
      allow update: if (canReadFeedbackThread(resource.data)
          && feedbackMessageStateUpdateOnly())
        || (isSuperAdmin() && feedbackModerationUpdateOnly())
        || (isRegistered() && role() == 'admin'
          && resource.data.target == 'cityAdmins'
          && resource.data.city == adminCity()
          && feedbackModerationUpdateOnly());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadFeedbackThread(
          get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data
        );
        allow create: if (
          canReadFeedbackThread(get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data)
          && request.resource.data.senderUid == request.auth.uid
        ) || (
          (!signedIn() || isAnonymous())
          && request.resource.data.senderUid == null
          && get(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data.senderGuestId == request.resource.data.senderGuestId
        );
        allow update, delete: if false;
      }
    }

    match /businessModerationNotices/{noticeId} {
      allow read: if isAdmin()
        || (isRegistered() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'businessId', 'businessName', 'reportId', 'decision',
          'reason', 'appealStatus', 'createdAt'
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.businessId is string
        && request.resource.data.reportId is string
        && request.resource.data.appealStatus == 'not-submitted';
      allow update: if isRegistered()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appealStatus', 'appealText', 'appealedAt', 'appealedBy'
        ])
        && request.resource.data.appealedBy == request.auth.uid
        && request.resource.data.appealStatus == 'submitted';
      allow delete: if false;
    }

    match /businessModerationAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reportId', 'businessId', 'conversationId', 'action', 'reason',
          'actorUid', 'actorRole', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && ((isAdmin() && request.resource.data.action in [
          'under-review', 'dismissed', 'takedown', 'conversation-blocked', 'closed'
        ]) || request.resource.data.action == 'business.appeal_submitted');
      allow update, delete: if false;
    }

    match /ai_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Edit OTPs — Cloud Function only ──────────────────────────────────────
    match /editOtps/{docId} {
      allow read, write: if false;
    }

    // ── Edit Sessions — Cloud Function only ──────────────────────────────────
    match /editSessions/{docId} {
      allow read, write: if false;
    }
  }
}
