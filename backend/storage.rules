rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event images: anyone can read; only authenticated users can upload
    // their own images (max 5MB, images only).
    match /event-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Business Directory imagery: public display, registered-owner uploads.
    match /business-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Community Update Message imagery: uploaded by admins/superAdmins only,
    // read is public so the Nodemailer/SMTP email send (which uses the
    // generated download URL, not app auth) and recipients' email clients can
    // load the image. Uploads are kept indefinitely; no delete rule is exposed.
    match /community-message-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin']
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // The automatic notification sound remains bundled in each app build.
    // Super Admins may replace only the longer recording used after a user
    // deliberately taps an Azaan alert or presses Play Azan in the app.
    match /azaan-recordings/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }
  }
}
