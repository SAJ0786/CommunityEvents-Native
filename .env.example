# Required for Google Maps tiles in standalone Android builds.
# Restrict the key to package info.siza.communityevents.app and the build certificate SHA-1.
GOOGLE_MAPS_API_KEY=

# App Check uses Play Integrity/App Attest in store builds. Internal APK,
# development-client and simulator profiles use the debug provider. For repeatable
# Firebase Test Lab/AWS runs, create a debug token in Firebase App Check and save
# it as a protected EAS environment variable. Never commit a real token here.
FIREBASE_APP_CHECK_DEBUG_TOKEN=
