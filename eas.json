{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester"
      }
    },
    "apk": {
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester"
      }
    },
    "ios-simulator": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_RELEASE_MODE": "tester"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_RELEASE_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
