{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "debug"
      },
      "channel": "development"
    },
    "apk": {
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "debug"
      },
      "channel": "preview"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "debug"
      },
      "channel": "preview"
    },
    "ios-simulator": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "debug"
      },
      "channel": "preview"
    },
    "ios-personal-testflight": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "production",
        "IOS_BUNDLE_IDENTIFIER": "info.siza.communityconnect.personaltest",
        "IOS_GOOGLE_SERVICES_FILE": "./GoogleService-Info.personal-test.plist"
      },
      "channel": "preview"
    },
    "registration-testflight": {
      "extends": "production",
      "env": {
        "APP_RELEASE_MODE": "tester",
        "APP_CHECK_PROVIDER": "production",
        "EVENT_REGISTRATION_CLIENT_ENABLED": "true",
        "CITY_MANAGEMENT_CLIENT_ENABLED": "false",
        "PROMOTION_AUDIENCE_CLIENT_ENABLED": "false"
      },
      "channel": "preview"
    },
    "registration-apk": {
      "extends": "apk",
      "env": {
        "EVENT_REGISTRATION_CLIENT_ENABLED": "true",
        "CITY_MANAGEMENT_CLIENT_ENABLED": "false",
        "PROMOTION_AUDIENCE_CLIENT_ENABLED": "false"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_RELEASE_MODE": "production",
        "APP_CHECK_PROVIDER": "production",
        "EVENT_REGISTRATION_CLIENT_ENABLED": "true",
        "CITY_MANAGEMENT_CLIENT_ENABLED": "false",
        "PROMOTION_AUDIENCE_CLIENT_ENABLED": "false"
      },
      "channel": "production"
    },
    "play-internal": {
      "extends": "registration-testflight",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "preview"
    }
  },
  "submit": {
    "ios-personal-testflight": {
      "ios": {
        "ascAppId": "6807323350"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "D36Y75H5BU",
        "ascAppId": "6782770347"
      }
    },
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
